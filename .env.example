# Self-hosting environment template.
# Copy to .env (or run ./install.sh, which generates the secrets for you).
# Docker Compose and install.sh read .env for variable substitution.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vrt

# RustFS object storage
RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=
RUSTFS_BUCKET=vrt
# Browser-reachable storage base used to build presigned screenshot URLs
RUSTFS_PUBLIC_URL=http://localhost:9000
# Lifetime of presigned URLs in seconds (SigV4 max: 604800)
RUSTFS_SIGNED_URL_TTL_SECONDS=3600
# Anonymous read policy; not needed because the API presigns URLs
RUSTFS_ENSURE_PUBLIC_BUCKET=false

# Bootstrap admin (first web UI login; remove after first login)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Admin API key (lets seed scripts / admins provision API keys)
ADMIN_API_KEY=

# Networking
BACKEND_PORT=3000
FRONTEND_PORT=80
CORS_ORIGIN=http://localhost,http://localhost:80

# Reverse proxy. The bundled docker-compose stack always serves the API through
# nginx, so true is the correct value there (and the compose default). Set false
# only when the API itself is reachable directly, with no proxy in front.
TRUST_PROXY=true

# Session cookie: set true when the UI is served over HTTPS (the cookie then
# carries the Secure flag). Leave false for a plain-HTTP localhost install.
AUTH_COOKIE_SECURE=false
# Hard ceiling for a sliding session (days from first login); independent of
# AUTH_SESSION_TTL_DAYS, which is the idle timeout.
AUTH_SESSION_ABSOLUTE_MAX_DAYS=90

# Browser-reachable dashboard base used in webhook links
APP_PUBLIC_URL=http://localhost

# Build identity reported by /api/v1/health. install.sh fills these in from the
# checkout (package.json version, git commit, build time); set them explicitly
# only when deploying an image that was built elsewhere.
# APP_VERSION=
# GIT_COMMIT=
# BUILD_TIME=

# Replaced baselines kept per test variant for restore (1-100)
BASELINE_HISTORY_LIMIT=10

# Postgres connections per process. Keep replicas x this below the database's
# max_connections (Postgres default: 100).
DATABASE_POOL_MAX=10

# Delivered/failed webhook payloads are deleted after this many days
WEBHOOK_DELIVERY_RETENTION_DAYS=30
