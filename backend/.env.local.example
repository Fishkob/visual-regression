# Local development environment
# Copy to .env.local and adjust values as needed

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrt"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vrt

# API
SWAGGER_BASE_URL=http://localhost:3000

# MinIO (local S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vrt
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# PDF sidecar (start via `docker compose -f docker-compose.infra.yml -f docker-compose.yml up -d pdf-sidecar` or `./scripts/dev.sh infra`)
PDF_SIDECAR_URL=http://localhost:3001
PDF_SIDECAR_TIMEOUT=30000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Logging
LOG_LEVEL=debug
NODE_ENV=development

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# OpenTelemetry (optional — for tracing / Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces