# Local development environment
# Copy to .env.local and adjust values as needed

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrt"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vrt

# API
SWAGGER_BASE_URL=http://localhost:3000

# RustFS (local S3-compatible storage)
RUSTFS_ENDPOINT=localhost
RUSTFS_PORT=9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=vrt
RUSTFS_USE_SSL=false
RUSTFS_PUBLIC_URL=http://localhost:9000
# Create the bucket + set an anonymous-read policy on startup (true = default).
# Set false when using a strict S3 provider (e.g. AWS S3) that blocks public access.
RUSTFS_ENSURE_PUBLIC_BUCKET=true

# PDF sidecar (start via `docker compose -f docker-compose.infra.yml -f docker-compose.yml up -d pdf-sidecar` or `./scripts/dev.sh infra`)
PDF_SIDECAR_URL=http://localhost:3001
PDF_SIDECAR_TIMEOUT=30000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
# Login throttle (brute-force guard on /auth/login)
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5
# Log ingestion throttle
LOG_THROTTLE_TTL=60
LOG_THROTTLE_LIMIT=100
# Reverse proxy — set true when served behind nginx/ingress so per-IP
# throttling and logging see the real client IP (X-Forwarded-For).
TRUST_PROXY=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_API_KEY_HEADER=x-api-key
# First admin user, bootstrapped on startup. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=debug
NODE_ENV=development

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# Seeders — seeds hit the REST API with x-api-key, so the key must exist in the
# backend DB. ./scripts/dev.sh seed sources this file and, if SEED_API_KEY is
# empty but ADMIN_API_KEY is set, provisions a key automatically. For direct
# `pnpm run seed:*` invocations, `export SEED_API_KEY=<rawKey>` first.
SEED_API_KEY=

# OpenTelemetry (optional — for tracing / Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces