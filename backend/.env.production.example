# Production environment
# Copy to .env.production and fill in actual values
# DO NOT commit .env.production with real secrets
#
# Full reference: backend/src/config/env.validation.ts

# Database
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# API
SWAGGER_BASE_URL=

# RustFS
RUSTFS_ENDPOINT=
RUSTFS_PORT=9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_USE_SSL=false
RUSTFS_PUBLIC_URL=

# Mode: 'api' (HTTP server) or 'worker' (comparison job poller)
# NODE_MODE=api

# CORS — comma-separated origins, or '*' for all
CORS_ORIGIN=

# Content Security Policy
# CSP_ENABLED=false

# Job queue — days to retain failed jobs before cleanup
# JOB_RETENTION_DAYS=7

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Login throttle (brute-force guard on /auth/login)
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5
# Log ingestion throttle
LOG_THROTTLE_TTL=60
LOG_THROTTLE_LIMIT=100
# Reverse proxy — set true when served behind nginx/ingress so per-IP
# throttling and logging see the real client IP (X-Forwarded-For).
TRUST_PROXY=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
# Set true when served behind TLS so the session cookie is only sent over HTTPS
AUTH_COOKIE_SECURE=false
AUTH_API_KEY_HEADER=x-api-key
# First admin user, bootstrapped on startup. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# Seeders
SEED_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=production