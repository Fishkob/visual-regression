# Production environment
# Copy to .env.production and fill in actual values
# DO NOT commit .env.production with real secrets
#
# Full reference: backend/src/config/env.validation.ts

# Database
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# API
SWAGGER_BASE_URL=

# RustFS
RUSTFS_ENDPOINT=
RUSTFS_PORT=9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_USE_SSL=false
RUSTFS_PUBLIC_URL=

# Mode: 'api' (HTTP server) or 'worker' (comparison job poller)
# NODE_MODE=api

# CORS — comma-separated origins, or '*' for all
CORS_ORIGIN=

# Content Security Policy
# CSP_ENABLED=false

# Job queue — days to retain failed jobs before cleanup
# JOB_RETENTION_DAYS=7

# Rate limits (requests per minute; 0 disables)
UPLOAD_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOG_RATE_LIMIT_PER_MINUTE=100
# Reverse proxy — set true when served behind nginx/ingress so the per-IP
# login/log rate limits and logging see the real client IP (X-Forwarded-For).
TRUST_PROXY=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
# Must be true in production: the session cookie is only sent over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_API_KEY_HEADER=x-api-key
# First admin user, bootstrapped on startup. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# Seeders
SEED_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=production