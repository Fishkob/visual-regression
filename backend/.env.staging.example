# Staging environment
# Copy to .env.staging and fill in actual values
# DO NOT commit .env.staging with real secrets

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrt"
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# API
SWAGGER_BASE_URL=

# Encrypts TOTP seeds at rest (required). Generate with `openssl rand -hex 32`.
TOTP_ENCRYPTION_KEY=

# RustFS
RUSTFS_ENDPOINT=
RUSTFS_PORT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_USE_SSL=
RUSTFS_PUBLIC_URL=

# CORS
CORS_ORIGIN=

# Rate limits (requests per minute; 0 disables)
UPLOAD_RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOG_RATE_LIMIT_PER_MINUTE=400
RENDER_RATE_LIMIT_PER_MINUTE=240
ADMIN_RATE_LIMIT_PER_MINUTE=120
# Reverse proxy — set true when served behind nginx/ingress so the per-IP
# login/log rate limits and logging see the real client IP (X-Forwarded-For).
TRUST_PROXY=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_API_KEY_HEADER=x-api-key
# First admin user, bootstrapped on startup. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# Seeders
SEED_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=staging