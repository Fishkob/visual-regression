# Staging environment
# Copy to .env.staging and fill in actual values
# DO NOT commit .env.staging with real secrets

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrt"
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# API
SWAGGER_BASE_URL=

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=
MINIO_PUBLIC_URL=

# CORS
CORS_ORIGIN=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=staging