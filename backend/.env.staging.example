# Staging environment
# Copy to .env.staging and fill in actual values
# DO NOT commit .env.staging with real secrets

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrt"
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# API
SWAGGER_BASE_URL=

# RustFS
RUSTFS_ENDPOINT=
RUSTFS_PORT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_USE_SSL=
RUSTFS_PUBLIC_URL=

# CORS
CORS_ORIGIN=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Login throttle (brute-force guard on /auth/login)
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5
# Log ingestion throttle
LOG_THROTTLE_TTL=60
LOG_THROTTLE_LIMIT=100
# Reverse proxy — set true when served behind nginx/ingress so per-IP
# throttling and logging see the real client IP (X-Forwarded-For).
TRUST_PROXY=false

# Authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_API_KEY_HEADER=x-api-key
# First admin user, bootstrapped on startup. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Metrics
METRICS_API_KEY=
ADMIN_API_KEY=

# Seeders
SEED_API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=staging