// ===== TRACES PIPELINE =====

otel.receiver_otlp "default" {
    grpc {
        endpoint = "0.0.0.0:4317"
    }
    http {
        endpoint = "0.0.0.0:4318"
    }

    output {
        traces = [
            otel.processor.batch.default.input,
            otel.connector.spanmetrics.default.input,
        ]
    }
}

otel.connector "spanmetrics" {
    histogram {
        explicit {
            buckets = [5ms, 10ms, 25ms, 50ms, 100ms, 250ms, 500ms, 1s, 2.5s, 5s, 10s]
        }
    }

    output {
        metrics = [otel.exporter.prometheus.default.input]
    }
}

otel.processor.batch "default" {
    timeout = "5s"
    send_batch_size = 512

    output {
        traces = [otel.exporter.otlp.tempo.input]
    }
}

otel.exporter.otlp "tempo" {
    client {
        endpoint = "tempo:4317"
        tls {
            insecure = true
        }
    }
}

otel.exporter.prometheus "default" { }

// ===== LOGS PIPELINE =====

loki.source.docker "default" {
    host = "unix:///var/run/docker.sock"
    refresh_interval = "15s"

    forward_to = [loki.process.json_parse.receiver]
}

loki.process "json_parse" {
    stage.json {
        expressions = {
            level  = "level",
            msg    = "msg",
            time   = "time",
            logger = "logger",
            thread = "thread",
        }
    }
    stage.timestamp {
        source = "time"
        format = "RFC3339Nano"
    }
    stage.labels {
        values = {
            level = null,
        }
    }

    forward_to = [loki.write.default.receiver]
}

loki.write "default" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}
