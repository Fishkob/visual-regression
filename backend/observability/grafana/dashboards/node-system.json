{
  "title": "Visual Regression – Node.js System",
  "uid": "vrt-node-system",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["visual-regression", "nodejs", "system", "prometheus"],
  "refresh": "10s",
  "panels": [
    {
      "title": "Event Loop Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds",
          "legendFormat": "lag"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      }
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[30s]) * 100",
          "legendFormat": "user"
        },
        {
          "expr": "rate(process_cpu_system_seconds_total[30s]) * 100",
          "legendFormat": "system"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 },
        "overrides": []
      }
    },
    {
      "title": "Heap Memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      }
    },
    {
      "title": "GC Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(nodejs_gc_duration_seconds_sum[1m]) * 1000",
          "legendFormat": "{{gc}}"
        }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 },
        "overrides": []
      }
    },
    {
      "title": "Active Handles & Requests",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "nodejs_active_handles_total",
          "legendFormat": "handles"
        },
        {
          "expr": "nodejs_active_requests_total",
          "legendFormat": "requests"
        }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0 },
        "overrides": []
      }
    },
    {
      "title": "Heap Space Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "nodejs_heap_space_size_used_bytes",
          "legendFormat": "{{space}}"
        }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      }
    }
  ]
}
