{
  "name": "visual-regression",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "build": "nest build && pnpm run copy:prisma",
    "copy:prisma": "rm -rf dist/prisma/generated && mkdir -p dist/prisma && cp -r prisma/generated dist/prisma/generated",
    "db:sync": "pnpm exec prisma migrate deploy",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:ui": "pnpm exec prisma studio",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "typecheck:test": "tsc6 -p tsconfig.test.json --noEmit",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:worker": "nest build && NODE_MODE=worker node dist/src/main",
    "start:prod": "node dist/src/main",
    "start:prod:tsx": "pnpm tsx dist/main.js",
    "swagger:export": "TS_NODE_PROJECT=tsconfig.swagger.json node -r ts-node/register -r tsconfig-paths/register src/scripts/swagger-export.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:cov:e2e": "vitest run --config vitest.config.e2e.ts --coverage",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "test:cov:all": "pnpm run test:cov && pnpm run test:cov:e2e && pnpm run coverage:merge",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:ci": "pnpm run db:prepare && pnpm run test:e2e",
    "test:e2e:ci:cov": "pnpm run db:prepare && pnpm run test:cov:e2e",
    "test:ui": "vitest --ui",
    "db:prepare": "pnpm run prisma:generate && POSTGRES_HOST=localhost POSTGRES_PORT=5432 POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres POSTGRES_DB=vrt pnpm exec prisma migrate deploy",
    "prisma:generate": "POSTGRES_HOST=localhost POSTGRES_PORT=5432 POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres POSTGRES_DB=vrt pnpm exec prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "@prometheus-io/client": "0.16.1",
    "axios": "^1.21.0",
    "body-parser": "2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "mime-types": "^3.0.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "^11.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/body-parser": "1.19.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  }
}
