model ProjectGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]

  @@map("ProjectGroup")
}

model Project {
  id              String        @id @default(cuid())
  name            String        @unique
  createdAt       DateTime      @default(now())
  groupId         String?
  group           ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  defaultBranchId String?       @unique
  defaultBranch   Branch?       @relation("DefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  baselineRevisionLimit Int?
  runHistoryDays        Int?
  orphanGraceHours      Int?
  storageQuotaBytes     BigInt?
  quotaSoftPercent      Int?          @default(80)
  requiredApprovals     Int           @default(1)
  branches        Branch[]      @relation("ProjectBranches")
  webhooks        WebhookEndpoint[]
  runs            Run[]
  assignments     ReviewAssignment[]

  @@index([groupId])
}

model Branch {
  id              String       @id @default(cuid())
  project         Project      @relation("ProjectBranches", fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  name            String
  targetBranchId  String?
  targetBranch    Branch?      @relation("BranchTarget", fields: [targetBranchId], references: [id], onDelete: SetNull)
  derivedBranches Branch[]     @relation("BranchTarget")
  defaultFor      Project?     @relation("DefaultBranch")
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  tests           UnifiedTest[]
  runs            Run[]

  @@unique([projectId, name])
  @@index([targetBranchId])
  @@map("Branch")
}

model UnifiedTest {
  id        String     @id @default(cuid())
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String
  name      String
  kind      TestKind   @default(image)
  status      TestStatus @default(PENDING)
  description String?
  tags        String[]   @default([])
  mutedUntil  DateTime?
  muteReason  String?
  sizePolicy  ImageSizePolicy @default(FAIL)
  createdAt   DateTime   @default(now())

  variants     UnifiedVariant[]
  screenshots  UnifiedScreenshot[]
  comparisons  UnifiedComparison[]
  baselineRevisions BaselineRevision[]
  runUploads   RunUpload[]
  comparisonJobs ComparisonJob[]
  assignments   ReviewAssignment[]

  @@unique([branchId, name])
  @@map("UnifiedTest")
}

model UnifiedVariant {
  id          String             @id @default(cuid())
  test        UnifiedTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId      String
  viewport    String
  browser     String
  environment String
  baselineId  String?            @unique
  baseline    UnifiedScreenshot? @relation("BaselineVariant", fields: [baselineId], references: [id])
  isInherited Boolean            @default(false)
  screenshots UnifiedScreenshot[]
  baselineRevisions BaselineRevision[]

  @@unique([testId, viewport, browser, environment])
  @@map("UnifiedVariant")
}

model UnifiedScreenshot {
  sizeBytes BigInt @default(0)
  id                 String            @id @default(cuid())
  test               UnifiedTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  variantId          String?
  variant            UnifiedVariant?   @relation(fields: [variantId], references: [id])
  type               ScreenshotType
  imageHash          String
  imageUrl           String
  pageCount          Int?
  pixelDiffThreshold Int               @default(0)
  createdAt          DateTime          @default(now())

  asBaseline         UnifiedVariant?       @relation("BaselineVariant")
  asBaselineComp     UnifiedComparison[]   @relation("BaselineComparison")
  asCandidateComp    UnifiedComparison[]   @relation("CandidateComparison")

  @@unique([testId, variantId, type])
  @@index([testId, type])
  @@index([imageUrl])
  @@map("UnifiedScreenshot")
}

model UnifiedComparison {
  id                 String              @id @default(cuid())
  test               UnifiedTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  runId              String?
  runKey             String?
  pageCount          Int?
  mismatchPixelCount Int
  mismatchPageCount  Int?
  diffSizeBytes      BigInt @default(0)
  diffImageUrl       String?
  diffPdfUrl         String?
  status             ComparisonStatus
  baselineId         String
  candidateId        String?
  createdAt          DateTime            @default(now())

  baseline  UnifiedScreenshot             @relation("BaselineComparison", fields: [baselineId], references: [id])
  candidate UnifiedScreenshot?            @relation("CandidateComparison", fields: [candidateId], references: [id])

  @@index([testId])
  @@index([status, createdAt])
  @@index([baselineId])
  @@index([candidateId])
  @@index([diffImageUrl])
  @@index([diffPdfUrl])
  @@index([runId])
  @@index([runKey])
  @@map("UnifiedComparison")
}

// Durable approval audit history. Deliberately has NO foreign key to the test:
// image approval deletes the comparison row and a test (or branch, or project)
// can be deleted, but the record of who approved what must survive all of it.
// The identifiers are therefore plain strings, denormalized at approval time.
// One row per reviewer's vote. The final Approval row is written only when the
// project's requiredApprovals threshold is reached; votes survive as the
// 4-eyes trail (comparisonId+userId is unique, so one reviewer counts once).
model ApprovalVote {
  id           String   @id @default(cuid())
  comparisonId String
  projectName  String
  testId       String
  userId       String
  username     String
  approvedAt   DateTime @default(now())

  @@unique([comparisonId, userId])
  @@index([projectName, approvedAt])
  @@index([comparisonId])
  @@map("ApprovalVote")
}

model Approval {
  id                 String   @id @default(cuid())
  projectName        String
  testName           String
  branchName         String?
  testId             String
  runId              String?
  runKey             String?
  testKind           TestKind
  variantViewport    String
  variantBrowser     String
  variantEnvironment String
  comparisonId       String
  baselineId         String
  candidateId        String
  candidateHash      String
  baselineHash       String?
  mismatchPixelCount Int?
  mismatchPageCount  Int?
  pageCount          Int?
  approvedBy         String
  approvedAt         DateTime @default(now())
  reason             ApprovalReason?
  note               String?

  @@index([projectName, testName, approvedAt])
  @@index([approvedAt])
  @@index([runId])
  @@index([runKey])
  @@map("Approval")
}

// Durable history of replaced baselines. Unlike Approval ("who approved
// what"), a revision keeps the file URL so an approval can be undone. The
// variant/test foreign keys make a deletion clean up its own history; files are
// reclaimed by the revision-prune path once no live row references them.
model BaselineRevision {
  id                 String                 @id @default(cuid())
  test               UnifiedTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  variant            UnifiedVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId          String
  viewport           String
  browser            String
  environment        String
  imageUrl           String
  imageHash          String
  pageCount          Int?
  pixelDiffThreshold Int                    @default(0)
  reason             BaselineRevisionReason
  createdBy          String?
  createdAt          DateTime               @default(now())

  @@index([testId, createdAt])
  @@index([variantId, createdAt])
  @@index([imageUrl])
  @@map("BaselineRevision")
}

// One outbound webhook target per project. The secret is stored readable
// because the dispatcher must sign every delivery (unlike API keys, which are
// hashed); the database is the trusted secret store in this self-hosted
// product. Events is the subscription list; format selects the JSON envelope.
model WebhookEndpoint {
  id         String            @id @default(cuid())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  url        String
  secret     String
  events     String[]
  format     WebhookFormat     @default(json)
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("WebhookEndpoint")
}

// Outbox row: written in the same transaction as the domain change, claimed by
// the worker-side dispatcher, retried with backoff. at-least-once.
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId     String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("WebhookDelivery")
}

// Durable audit trail. Deliberately no foreign keys: the actions it records
// (approval, restore, deletion, settings changes) outlive the rows they name,
// so project/test/branch names and target ids are denormalized at write time.
model AuditEvent {
  id          String   @id @default(cuid())
  actor       String?
  action      String
  projectName String?
  testName    String?
  branchName  String?
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([projectName, createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@map("AuditEvent")
}

model Run {
  id             String    @id @default(cuid())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId       String
  key            String
  commitSha      String?
  commitMessage  String?
  ciUrl          String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  finishedAt     DateTime?
  finishedBy     String?
  uploads        RunUpload[]
  assignments    ReviewAssignment[]

  @@unique([branchId, key])
  @@index([projectId, createdAt])
  @@index([finishedAt, lastActivityAt])
  @@map("Run")
}

// One row per upload that carried a run key. Jobs/comparisons are deleted or
// retired over time, so the upload itself is the durable "this run touched that
// test/variant" record — run grouping must survive baseline-only uploads and
// approvals.
model RunUpload {
  id          String    @id @default(cuid())
  run         Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  test        UnifiedTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId      String
  kind        TestKind
  viewport    String
  browser     String
  environment String
  contentHash String
  outcome     String
  createdAt   DateTime  @default(now())

  @@index([runId, testId])
  @@index([testId])
  @@map("RunUpload")
}

// Durable analytics history. Comparisons are deleted on approval and the
// candidate rows are reclaimed, so the completion outcome (and the run/test
// context) would otherwise disappear. This table feeds trends and flake rates;
// it has no foreign keys so deleting a test/run does not erase its history.
model ComparisonOutcomeEvent {
  id             String   @id @default(cuid())
  testId         String
  testName       String
  kind           TestKind
  viewport       String
  browser        String
  environment    String
  comparisonId   String?
  runId          String?
  runKey         String?
  outcome        String
  mismatchMetric Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([testId, createdAt])
  @@index([runKey])
  @@index([comparisonId])
  @@map("ComparisonOutcomeEvent")
}

model ComparisonJob {
  id                  String        @id @default(cuid())
  test                UnifiedTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId              String
  runId               String?
  runKey              String?
  payload             Json
  candidateId         String?
  variantViewport     String?
  variantBrowser      String?
  variantEnvironment  String?
  status              JobStatus     @default(PENDING)
  attempts            Int           @default(0)
  maxAttempts         Int           @default(3)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  heartbeatAt         DateTime?
  error               String?
  createdAt           DateTime      @default(now())
  completedAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, heartbeatAt])
  @@index([status, candidateId])
  @@index([status, completedAt])
  @@index([testId])
  @@index([createdAt])
  @@index([runId])
  @@index([runKey])
}

enum ApprovalReason {
  INTENDED_CHANGE
  FLAKE
  INFRA
}

enum ShareScope {
  PROJECT
  TEST
  RUN
}

enum ImageSizePolicy {
  FAIL
  PAD
  CROP
  RESIZE
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               UserRole  @default(MEMBER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  deactivatedAt      DateTime?
  createdBy          String?
  totpSecret         String?
  totpEnabledAt      DateTime?
  createdAt          DateTime  @default(now())

  sessions            Session[]
  assignments         ReviewAssignment[] @relation("AssignmentAssignee")
  recoveryCodes       RecoveryCode[]
  twoFactorChallenges TwoFactorChallenge[]
  apiKeys             ApiKey[]            @relation("ApiKeyOwner")

  @@index([role, isActive])
  @@map("User")
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("Session")
}

// Short-lived second factor challenge. Only the hash of the bearer token is
// stored, like a session token; the row dies on success or after five minutes.
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("TwoFactorChallenge")
}

// Recovery codes are single-use and stored hashed (SHA-256). A used code is
// kept with usedAt so a replayed code fails and the audit trail survives.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("RecoveryCode")
}

model ApiKey {
  id            String    @id @default(cuid())
  name          String    @unique
  keyHash       String    @unique
  keyHint       String?
  owner         User?     @relation("ApiKeyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId       String?
  scopes        String[]  @default(["upload", "read", "approve"])
  projectNames  String[]  @default([])
  createdBy     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?

  @@index([ownerId])
  @@map("ApiKey")
}

model ShareLink {
  id             String     @id @default(cuid())
  tokenHash      String     @unique
  scope          ShareScope
  projectName    String
  testName       String?
  branchName     String?
  runKey         String?
  createdBy      String?
  passphraseHash String?
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  accessCount    Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([projectName])
  @@index([expiresAt])
  @@map("ShareLink")
}

model ReviewComment {
  id           String    @id @default(cuid())
  projectName  String
  branchName   String?
  testId       String
  comparisonId String?
  body         String
  authorId     String?
  author       String
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())

  @@index([testId, createdAt])
  @@index([comparisonId])
  @@index([projectName, createdAt])
  @@map("ReviewComment")
}

model ReviewAssignment {
  id               String    @id @default(cuid())
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  branchName       String?
  test             UnifiedTest? @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId           String?
  run              Run?      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId            String?
  assignee         User      @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId       String
  assigneeUsername String
  assignedBy       String
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([assigneeId, completedAt])
  @@index([projectId])
  @@index([testId])
  @@index([runId])
  @@map("ReviewAssignment")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String   // "login" | "log" | "upload"
  key         String   // login/log: "ip:<ip>", upload: "apikey:<id>"
  windowStart DateTime // minute-aligned
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([scope, key, windowStart])
  @@index([windowStart])
  @@map("RateLimitBucket")
}

enum TestKind {
  image
  pdf
}

enum ScreenshotType {
  BASELINE
  CURRENT
}

enum ComparisonStatus {
  PENDING_APPROVAL
  APPROVED
}

enum TestStatus {
  PENDING
  UNCHANGED
  PENDING_APPROVAL
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BaselineRevisionReason {
  approval
  restore
  import
}

enum WebhookFormat {
  json
  slack
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
