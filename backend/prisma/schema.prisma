model ProjectGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]

  @@map("ProjectGroup")
}

model Project {
  id              String        @id @default(cuid())
  name            String        @unique
  createdAt       DateTime      @default(now())
  groupId         String?
  group           ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  defaultBranchId String?       @unique
  defaultBranch   Branch?       @relation("DefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  branches        Branch[]      @relation("ProjectBranches")
  webhooks        WebhookEndpoint[]

  @@index([groupId])
}

model Branch {
  id              String       @id @default(cuid())
  project         Project      @relation("ProjectBranches", fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  name            String
  targetBranchId  String?
  targetBranch    Branch?      @relation("BranchTarget", fields: [targetBranchId], references: [id], onDelete: SetNull)
  derivedBranches Branch[]     @relation("BranchTarget")
  defaultFor      Project?     @relation("DefaultBranch")
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  tests           UnifiedTest[]

  @@unique([projectId, name])
  @@index([targetBranchId])
  @@map("Branch")
}

model UnifiedTest {
  id        String     @id @default(cuid())
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String
  name      String
  kind      TestKind   @default(image)
  status    TestStatus @default(PENDING)
  createdAt DateTime   @default(now())

  variants     UnifiedVariant[]
  screenshots  UnifiedScreenshot[]
  comparisons  UnifiedComparison[]
  baselineRevisions BaselineRevision[]

  @@unique([branchId, name])
  @@map("UnifiedTest")
}

model UnifiedVariant {
  id          String             @id @default(cuid())
  test        UnifiedTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId      String
  viewport    String
  browser     String
  environment String
  baselineId  String?            @unique
  baseline    UnifiedScreenshot? @relation("BaselineVariant", fields: [baselineId], references: [id])
  isInherited Boolean            @default(false)
  screenshots UnifiedScreenshot[]
  baselineRevisions BaselineRevision[]

  @@unique([testId, viewport, browser, environment])
  @@map("UnifiedVariant")
}

model UnifiedScreenshot {
  id                 String            @id @default(cuid())
  test               UnifiedTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  variantId          String?
  variant            UnifiedVariant?   @relation(fields: [variantId], references: [id])
  type               ScreenshotType
  imageHash          String
  imageUrl           String
  pageCount          Int?
  pixelDiffThreshold Int               @default(0)
  createdAt          DateTime          @default(now())

  asBaseline         UnifiedVariant?       @relation("BaselineVariant")
  asBaselineComp     UnifiedComparison[]   @relation("BaselineComparison")
  asCandidateComp    UnifiedComparison[]   @relation("CandidateComparison")

  @@unique([testId, variantId, type])
  @@index([testId, type])
  @@index([imageUrl])
  @@map("UnifiedScreenshot")
}

model UnifiedComparison {
  id                 String              @id @default(cuid())
  test               UnifiedTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  pageCount          Int?
  mismatchPixelCount Int
  mismatchPageCount  Int?
  diffImageUrl       String?
  diffPdfUrl         String?
  status             ComparisonStatus
  baselineId         String
  candidateId        String?
  createdAt          DateTime            @default(now())

  baseline  UnifiedScreenshot             @relation("BaselineComparison", fields: [baselineId], references: [id])
  candidate UnifiedScreenshot?            @relation("CandidateComparison", fields: [candidateId], references: [id])

  @@index([testId])
  @@index([status, createdAt])
  @@index([baselineId])
  @@index([candidateId])
  @@index([diffImageUrl])
  @@index([diffPdfUrl])
  @@map("UnifiedComparison")
}

// Durable approval audit history. Deliberately has NO foreign key to the test:
// image approval deletes the comparison row and a test (or branch, or project)
// can be deleted, but the record of who approved what must survive all of it.
// The identifiers are therefore plain strings, denormalized at approval time.
model Approval {
  id                 String   @id @default(cuid())
  projectName        String
  testName           String
  branchName         String?
  testId             String
  testKind           TestKind
  variantViewport    String
  variantBrowser     String
  variantEnvironment String
  comparisonId       String
  baselineId         String
  candidateId        String
  candidateHash      String
  baselineHash       String?
  mismatchPixelCount Int?
  mismatchPageCount  Int?
  pageCount          Int?
  approvedBy         String
  approvedAt         DateTime @default(now())

  @@index([projectName, testName, approvedAt])
  @@index([approvedAt])
  @@map("Approval")
}

// Durable history of replaced baselines. Unlike Approval ("who approved
// what"), a revision keeps the file URL so an approval can be undone. The
// variant/test foreign keys make a deletion clean up its own history; files are
// reclaimed by the revision-prune path once no live row references them.
model BaselineRevision {
  id                 String                 @id @default(cuid())
  test               UnifiedTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  variant            UnifiedVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId          String
  viewport           String
  browser            String
  environment        String
  imageUrl           String
  imageHash          String
  pageCount          Int?
  pixelDiffThreshold Int                    @default(0)
  reason             BaselineRevisionReason
  createdBy          String?
  createdAt          DateTime               @default(now())

  @@index([testId, createdAt])
  @@index([variantId, createdAt])
  @@index([imageUrl])
  @@map("BaselineRevision")
}

// One outbound webhook target per project. The secret is stored readable
// because the dispatcher must sign every delivery (unlike API keys, which are
// hashed); the database is the trusted secret store in this self-hosted
// product. Events is the subscription list; format selects the JSON envelope.
model WebhookEndpoint {
  id         String            @id @default(cuid())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  url        String
  secret     String
  events     String[]
  format     WebhookFormat     @default(json)
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("WebhookEndpoint")
}

// Outbox row: written in the same transaction as the domain change, claimed by
// the worker-side dispatcher, retried with backoff. at-least-once.
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId     String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("WebhookDelivery")
}

// Durable audit trail. Deliberately no foreign keys: the actions it records
// (approval, restore, deletion, settings changes) outlive the rows they name,
// so project/test/branch names and target ids are denormalized at write time.
model AuditEvent {
  id          String   @id @default(cuid())
  actor       String?
  action      String
  projectName String?
  testName    String?
  branchName  String?
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([projectName, createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@map("AuditEvent")
}

model ComparisonJob {
  id                  String        @id @default(cuid())
  testId              String
  payload             Json
  candidateId         String?
  variantViewport     String?
  variantBrowser      String?
  variantEnvironment  String?
  status              JobStatus     @default(PENDING)
  attempts            Int           @default(0)
  maxAttempts         Int           @default(3)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  heartbeatAt         DateTime?
  error               String?
  createdAt           DateTime      @default(now())
  completedAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, heartbeatAt])
  @@index([status, candidateId])
  @@index([status, completedAt])
  @@index([testId])
  @@index([createdAt])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  sessions Session[]

  @@map("User")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("Session")
}

model ApiKey {
  id            String    @id @default(cuid())
  name          String
  keyHash       String    @unique
  keyHint       String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?

  @@map("ApiKey")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String   // "login" | "log" | "upload"
  key         String   // login/log: "ip:<ip>", upload: "apikey:<id>"
  windowStart DateTime // minute-aligned
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([scope, key, windowStart])
  @@index([windowStart])
  @@map("RateLimitBucket")
}

enum TestKind {
  image
  pdf
}

enum ScreenshotType {
  BASELINE
  CURRENT
}

enum ComparisonStatus {
  PENDING_APPROVAL
  APPROVED
}

enum TestStatus {
  PENDING
  UNCHANGED
  PENDING_APPROVAL
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BaselineRevisionReason {
  approval
  restore
  import
}

enum WebhookFormat {
  json
  slack
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
