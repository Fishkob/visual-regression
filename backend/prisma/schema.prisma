model ProjectGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]

  @@map("ProjectGroup")
}

model Project {
  id                     String             @id @default(cuid())
  name                   String             @unique
  createdAt              DateTime           @default(now())
  groupId                String?
  group                  ProjectGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  defaultBranchId        String?            @unique
  defaultBranch          Branch?            @relation("DefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  baselineRevisionLimit  Int?
  runHistoryDays         Int?
  // Days without an upload before this project's non-default branches are
  // deleted by the branch-retention sweep. Null means "use the deployment
  // default"; `0` disables the sweep for this project. See ADR-067.
  branchRetentionDays    Int?
  orphanGraceHours       Int?
  storageQuotaBytes      BigInt?
  quotaSoftPercent       Int?               @default(80)
  // Cached byte total of this project's evidence (screenshot rows + diff
  // artifacts), written ONLY by the quota check in StorageUsageService when the
  // value is older than its refresh window. The rows stay the truth: the cached
  // number is a `SUM` over them, re-derived from scratch on every refresh, so a
  // stale value can only be conservative (it over-reports after a deletion) or
  // lag the uploads of one window. Null means "never computed". See ADR-060.
  storageUsedBytes       BigInt?
  storageUsageComputedAt DateTime?
  // Project-wide fallback tolerance in pixels. A variant whose baseline has no
  // threshold of its own (0) inherits this value; an explicit per-variant
  // threshold always wins. Null means "no project default".
  pixelDiffThreshold     Int?
  branches               Branch[]           @relation("ProjectBranches")
  webhooks               WebhookEndpoint[]
  runs                   Run[]
  assignments            ReviewAssignment[]
  shareLinks             ShareLink[]

  @@index([groupId])
  // Trigram index for the case-insensitive substring search (project list,
  // global search): `ILIKE '%q%'` cannot use a btree, so without it every search
  // is a sequential scan. Requires the `pg_trgm` extension, which the
  // query_performance_indexes migration creates.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Project_name_trgm_idx")
}

model Branch {
  id              String        @id @default(cuid())
  project         Project       @relation("ProjectBranches", fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  name            String
  targetBranchId  String?
  targetBranch    Branch?       @relation("BranchTarget", fields: [targetBranchId], references: [id], onDelete: SetNull)
  derivedBranches Branch[]      @relation("BranchTarget")
  defaultFor      Project?      @relation("DefaultBranch")
  isArchived      Boolean       @default(false)
  // The last upload that reached this branch, touched by the intake path (at
  // most once per window). It is the clock the branch-retention sweep reads:
  // "no compare here for N days" cannot be derived from comparisons, because an
  // identical upload writes one, and a run key is optional. See ADR-067.
  lastActivityAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())
  tests           UnifiedTest[]
  runs            Run[]

  @@unique([projectId, name])
  @@index([targetBranchId])
  // The retention sweep's filter: one project's branches by activity.
  @@index([projectId, lastActivityAt])
  // Substring search on the branch name (global search).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Branch_name_trgm_idx")
  @@map("Branch")
}

model UnifiedTest {
  id          String          @id @default(cuid())
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId    String
  name        String
  kind        TestKind        @default(image)
  status      TestStatus      @default(PENDING)
  description String?
  tags        String[]        @default([])
  mutedUntil  DateTime?
  muteReason  String?
  sizePolicy  ImageSizePolicy @default(FAIL)
  createdAt   DateTime        @default(now())

  variants          UnifiedVariant[]
  screenshots       UnifiedScreenshot[]
  comparisons       UnifiedComparison[]
  baselineRevisions BaselineRevision[]
  runUploads        RunUpload[]
  comparisonJobs    ComparisonJob[]
  assignments       ReviewAssignment[]
  comments          ReviewComment[]

  @@unique([branchId, name])
  // Substring search on the test name: the global search, the inbox `q` filter,
  // the project overview's variant page and "approve all" all match with
  // `ILIKE '%q%'`, which no btree can serve.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "UnifiedTest_name_trgm_idx")
  // The inbox and the pending-tests list filter with `tags: { has: tag }`,
  // which Postgres answers with an array-containment operator: btree cannot
  // serve it, GIN can.
  @@index([tags], type: Gin)
  @@map("UnifiedTest")
}

model UnifiedVariant {
  id                String              @id @default(cuid())
  test              UnifiedTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId            String
  viewport          String
  browser           String
  environment       String
  baselineId        String?             @unique
  baseline          UnifiedScreenshot?  @relation("BaselineVariant", fields: [baselineId], references: [id])
  isInherited       Boolean             @default(false)
  screenshots       UnifiedScreenshot[]
  baselineRevisions BaselineRevision[]

  @@unique([testId, viewport, browser, environment])
  @@map("UnifiedVariant")
}

model UnifiedScreenshot {
  sizeBytes          BigInt         @default(0)
  id                 String         @id @default(cuid())
  test               UnifiedTest    @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  // A screenshot always belongs to a variant: the row is read through it and
  // the (testId, variantId, type) unique key is the only thing that keeps a
  // test from holding two CURRENT rows. Nullable would make that key ignore
  // the row (Postgres treats NULLs as distinct) and leave a variant delete
  // with rows no reader can reach. Legacy rows without a variant are cleared
  // by the 20261124090000_schema_hardening migration.
  variantId          String
  variant            UnifiedVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type               ScreenshotType
  imageHash          String
  imageUrl           String
  pageCount          Int?
  pixelDiffThreshold Int            @default(0)
  createdAt          DateTime       @default(now())

  asBaseline      UnifiedVariant?     @relation("BaselineVariant")
  asBaselineComp  UnifiedComparison[] @relation("BaselineComparison")
  asCandidateComp UnifiedComparison[] @relation("CandidateComparison")

  // testId is the leading column, so this also serves the old
  // `(testId, type)` lookups — that separate index was pure write cost.
  @@unique([testId, variantId, type])
  @@index([imageUrl])
  @@map("UnifiedScreenshot")
}

model UnifiedComparison {
  id                 String           @id @default(cuid())
  test               UnifiedTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  runId              String?
  runKey             String?
  pageCount          Int?
  mismatchPixelCount Int
  mismatchPageCount  Int?
  diffSizeBytes      BigInt           @default(0)
  diffImageUrl       String?
  diffPdfUrl         String?
  // Changed areas of the diff, for the review page (see ChangedRegion): the
  // worker already holds the mask, and the browser cannot recompute it from the
  // stored diff image. Null for comparisons written before the column existed.
  changedRegions     Json?
  status             ComparisonStatus
  baselineId         String
  candidateId        String?
  createdAt          DateTime         @default(now())

  baseline  UnifiedScreenshot  @relation("BaselineComparison", fields: [baselineId], references: [id])
  candidate UnifiedScreenshot? @relation("CandidateComparison", fields: [candidateId], references: [id])

  @@index([testId])
  @@index([status, createdAt])
  @@index([baselineId])
  @@index([candidateId])
  @@index([diffImageUrl])
  @@index([diffPdfUrl])
  @@index([runId])
  @@index([runKey])
  @@map("UnifiedComparison")
}

// Durable approval audit history. Deliberately has NO foreign key to the test:
// image approval deletes the comparison row and a test (or branch, or project)
// can be deleted, but the record of who approved what must survive all of it.
// The identifiers are therefore plain strings, denormalized at approval time.

model Approval {
  id                 String          @id @default(cuid())
  // Stable project identity for filtering the trail; `projectName` stays as the
  // name at approval time for display. projectId is resolved from the name by
  // the 20261124100000_project_identity trigger, so a writer cannot forget it
  // and a rename cannot split the trail.
  projectId          String?
  projectName        String
  testName           String
  branchName         String?
  testId             String
  runId              String?
  runKey             String?
  testKind           TestKind
  variantViewport    String
  variantBrowser     String
  variantEnvironment String
  comparisonId       String
  baselineId         String
  candidateId        String
  candidateHash      String
  baselineHash       String?
  mismatchPixelCount Int?
  mismatchPageCount  Int?
  pageCount          Int?
  approvedBy         String
  approvedAt         DateTime        @default(now())
  reason             ApprovalReason?
  note               String?

  @@index([projectId, testName, approvedAt])
  @@index([approvedAt])
  @@index([runId])
  @@index([runKey])
  @@map("Approval")
}

// Durable history of replaced baselines. Unlike Approval ("who approved
// what"), a revision keeps the file URL so an approval can be undone. The
// variant/test foreign keys make a deletion clean up its own history; files are
// reclaimed by the revision-prune path once no live row references them.
model BaselineRevision {
  id                 String                 @id @default(cuid())
  test               UnifiedTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId             String
  variant            UnifiedVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId          String
  viewport           String
  browser            String
  environment        String
  imageUrl           String
  imageHash          String
  pageCount          Int?
  pixelDiffThreshold Int                    @default(0)
  reason             BaselineRevisionReason
  createdBy          String?
  createdAt          DateTime               @default(now())

  @@index([testId, createdAt])
  @@index([variantId, createdAt])
  @@index([imageUrl])
  @@map("BaselineRevision")
}

// One outbound webhook target per project. The secret is stored readable
// because the dispatcher must sign every delivery (unlike API keys, which are
// hashed); the database is the trusted secret store in this self-hosted
// product. Events is the subscription list; format selects the JSON envelope.
model WebhookEndpoint {
  id         String            @id @default(cuid())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  url        String
  secret     String
  events     String[]
  format     WebhookFormat     @default(json)
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]

  // One endpoint per URL per project: two rows for the same target double every
  // delivery and are always a mistake, never a feature.
  @@unique([projectId, url])
  @@index([projectId])
  @@map("WebhookEndpoint")
}

// Outbox row: written in the same transaction as the domain change, claimed by
// the worker-side dispatcher, retried with backoff. at-least-once.
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId     String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  claimedAt      DateTime?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  // Serves the retention sweep (`status IN (DELIVERED, FAILED) AND createdAt <
  // cutoff`), which otherwise scans the whole outbox once a day.
  @@index([status, createdAt])
  @@index([endpointId, createdAt])
  @@map("WebhookDelivery")
}

// Durable audit trail. Deliberately no foreign keys: the actions it records
// (approval, restore, deletion, settings changes) outlive the rows they name,
// so project/test/branch names and target ids are denormalized at write time.
model AuditEvent {
  id          String   @id @default(cuid())
  actor       String?
  action      String
  // Resolved at insert time from projectName by the project-identity trigger;
  // null for actions that name no project (or a project that no longer exists).
  // Filtering uses the id so a rename does not hide the project's own trail.
  projectId   String?
  projectName String?
  testName    String?
  branchName  String?
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
  @@map("AuditEvent")
}

model Run {
  id             String             @id @default(cuid())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId       String
  key            String
  commitSha      String?
  commitMessage  String?
  ciUrl          String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  lastActivityAt DateTime           @default(now())
  finishedAt     DateTime?
  finishedBy     String?
  uploads        RunUpload[]
  assignments    ReviewAssignment[]

  @@unique([branchId, key])
  @@index([projectId, createdAt])
  @@index([finishedAt, lastActivityAt])
  @@map("Run")
}

// One row per upload that carried a run key. Jobs/comparisons are deleted or
// retired over time, so the upload itself is the durable "this run touched that
// test/variant" record — run grouping must survive baseline-only uploads and
// approvals.
model RunUpload {
  id          String      @id @default(cuid())
  run         Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  test        UnifiedTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId      String
  kind        TestKind
  viewport    String
  browser     String
  environment String
  contentHash String
  outcome     String
  createdAt   DateTime    @default(now())

  @@index([runId, testId])
  @@index([testId])
  @@map("RunUpload")
}

// Durable analytics history. Comparisons are deleted on approval and the
// candidate rows are reclaimed, so the completion outcome (and the run/test
// context) would otherwise disappear. This table feeds trends and flake rates;
// it has no foreign keys so deleting a test/run does not erase its history.
// The project is denormalized at write time for exactly that reason: without
// it, per-project trends would have to join test -> branch -> project and would
// silently drop the history of a deleted test. Nullable because rows written
// before the column existed whose test is already gone cannot be attributed.
model ComparisonOutcomeEvent {
  id             String   @id @default(cuid())
  // Resolved at insert time from projectName by the project-identity trigger.
  // Trends filter by this id, so a rename keeps the history and a recycled name
  // does not inherit another project's numbers. projectName stays for display.
  projectId      String?
  projectName    String?
  testId         String
  testName       String
  kind           TestKind
  viewport       String
  browser        String
  environment    String
  comparisonId   String?
  runId          String?
  runKey         String?
  outcome        String
  mismatchMetric Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([testId, createdAt])
  @@index([runKey])
  @@index([comparisonId])
  @@index([projectId, createdAt])
  @@map("ComparisonOutcomeEvent")
}

model ComparisonJob {
  id                  String      @id @default(cuid())
  test                UnifiedTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId              String
  runId               String?
  runKey              String?
  payload             Json
  candidateId         String?
  variantViewport     String?
  variantBrowser      String?
  variantEnvironment  String?
  status              JobStatus   @default(PENDING)
  attempts            Int         @default(0)
  maxAttempts         Int         @default(5)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  heartbeatAt         DateTime?
  error               String?
  createdAt           DateTime    @default(now())
  completedAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, heartbeatAt])
  @@index([status, candidateId])
  @@index([status, completedAt])
  // Serves the worker's claim: equality on status + ORDER BY "createdAt", so the
  // scan stops at the first claimable row instead of filtering retained history.
  @@index([status, createdAt])
  @@index([testId])
  // Every retained `createdAt` / `runKey` lookup starts with `status` (claim,
  // failed list) or names `runId` (run status), so the single-column indexes on
  // those two columns only cost writes on the queue's hottest table.
  @@index([runId])
}

enum ApprovalReason {
  INTENDED_CHANGE
  FLAKE
  INFRA
}

enum ShareScope {
  PROJECT
  TEST
  RUN
}

enum ImageSizePolicy {
  FAIL
  PAD
  CROP
  RESIZE
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  role               UserRole  @default(MEMBER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  deactivatedAt      DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())

  sessions    Session[]
  assignments ReviewAssignment[] @relation("AssignmentAssignee")
  apiKeys     ApiKey[]           @relation("ApiKeyOwner")

  @@index([role, isActive])
  @@map("User")
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("Session")
}

model ApiKey {
  id            String    @id @default(cuid())
  name          String    @unique
  keyHash       String    @unique
  keyHint       String?
  owner         User?     @relation("ApiKeyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId       String?
  scopes        String[]  @default(["upload", "read", "approve"])
  // Project allowlist as ids, not names: a rename must not silently narrow the
  // key (the name no longer matches) and a deleted-then-recreated project name
  // must not silently widen it. Empty means "all projects".
  projectIds    String[]  @default([])
  createdBy     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?

  @@index([ownerId])
  @@map("ApiKey")
}

model ShareLink {
  id             String     @id @default(cuid())
  tokenHash      String     @unique
  scope          ShareScope
  // The link names its project by id and dies with it: a name-keyed link would
  // outlive the project and re-validate against a new project that recycles the
  // name, serving someone else's evidence (ADR-038).
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  testName       String?
  branchName     String?
  runKey         String?
  createdBy      String?
  passphraseHash String?
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  accessCount    Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([projectId])
  @@index([expiresAt])
  @@map("ShareLink")
}

model ReviewComment {
  id           String    @id @default(cuid())
  projectName  String
  branchName   String?
  // The test owns the discussion: the row dies with it (ON DELETE CASCADE), and
  // the database — not a maintenance sweep — is what says so. `comparisonId`
  // deliberately has NO foreign key: approval deletes the comparison row while
  // the discussion that led to it must survive.
  test         UnifiedTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId       String
  comparisonId String?
  body         String
  authorId     String?
  author       String
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())

  @@index([testId, createdAt])
  @@index([comparisonId])
  @@index([projectName, createdAt])
  @@map("ReviewComment")
}

model ReviewAssignment {
  id               String       @id @default(cuid())
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  branchName       String?
  test             UnifiedTest? @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId           String?
  run              Run?         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId            String?
  assignee         User         @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId       String
  assigneeUsername String
  assignedBy       String
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([assigneeId, completedAt])
  @@index([projectId])
  @@index([testId])
  @@index([runId])
  @@map("ReviewAssignment")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String // "login" | "log" | "upload"
  key         String // login/log: "ip:<ip>", upload: "apikey:<id>"
  windowStart DateTime // minute-aligned
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([scope, key, windowStart])
  @@index([windowStart])
  @@map("RateLimitBucket")
}

enum TestKind {
  image
  pdf
}

enum ScreenshotType {
  BASELINE
  CURRENT
}

enum ComparisonStatus {
  PENDING_APPROVAL
  APPROVED
}

enum TestStatus {
  PENDING
  UNCHANGED
  PENDING_APPROVAL
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BaselineRevisionReason {
  approval
  restore
  import
}

enum WebhookFormat {
  json
  slack
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
