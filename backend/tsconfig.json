{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@app": ["./src/app.module"],
      "@config/*": ["./src/config/*"],
      "@prisma/*": ["./src/prisma/*"],
      "@common/*": ["./src/common/*"],
      "@public/*": ["./src/modules/public/*"],
      "@internal/*": ["./src/modules/internal/*"],
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
    "types": ["node", "jest", "express", "multer"],
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "prisma/generated/**/*"]
}
