  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Intake & auth",
      "items": [
        "CI authenticates via the x-api-key header — only its SHA-256 hash is stored",
        "Reviewers log in with a session cookie; login throttled to 5 attempts/min",
        "Outcomes: IDENTICAL (hash match) · BASELINE_CREATED (first upload) · COMPARISON_QUEUED"
      ]
    },
    {
      "dot": "emerald",
      "title": "Comparison pipeline",
      "items": [
        "Pixelmatch diffs images in-process; PDF diffs delegate to the Java sidecar",
        "PostgreSQL polling queue — one ComparisonJob table, no broker",
        "At most one PENDING_APPROVAL per variant; threshold auto-accept",
        "Storage-first writes with compensating delete; daily cron sweeps orphans"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & data",
      "items": [
        "Designed for private/trusted networks; RustFS bucket is public-read",
        "The browser loads screenshots directly from RustFS; health, metrics, and log-ingestion endpoints are public",
        "Optional: API, worker, and pdf-sidecar export OTLP traces + Prometheus metrics when deployed"
      ]
    }
  ]
}
