  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Data Path",
      "items": [
        "CI uploads a CURRENT screenshot through the API-key protected intake",
        "The job queue feeds the comparison engine; results land as PENDING_APPROVAL",
        "Reviewers read the pending list and approve per comparisonId"
      ]
    },
    {
      "dot": "rose",
      "title": "Sensitivity Gates",
      "items": [
        "External uploads cross an authenticated, rate-limited boundary",
        "Approval is human-gated and pinned to the comparison the reviewer saw",
        "Threshold auto-accept is an automated override of the review gate"
      ]
    },
    {
      "dot": "amber",
      "title": "Artifact Lifecycle",
      "items": [
        "Screenshots and diff artifacts live in RustFS; rows live in PostgreSQL",
        "Approval reclaims the candidate and diff files after commit",
        "Image diffs run pixelmatch; PDF diffs run through the pdf-sidecar"
      ]
    }
  ]
