FROM node:26-bookworm@sha256:a546d3f8acd2af4382668a7e6acd3bc4418e6a27478373e3246f8162f5181509

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY package.json ./
RUN PNPM_VERSION="$(node -p "require('./package.json').packageManager.split('@').pop()")" && npm install -g "pnpm@${PNPM_VERSION}"

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY frontend/package.json ./frontend/
COPY client-sdk/package.json ./client-sdk/
COPY backend/package.json ./backend/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter ./frontend exec playwright install --with-deps chromium

COPY frontend ./frontend
COPY client-sdk ./client-sdk

RUN chown -R node:node /app /ms-playwright

WORKDIR /app/frontend
USER node
