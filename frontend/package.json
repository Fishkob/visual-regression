{
  "name": "frontend",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,vue}\" \"playwright/gallery/**/*.ts\" \"tests/ct/**/*.ts\" \"tests/e2e/**/*.ts\" \"playwright-ct.config.ts\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,vue}\" \"playwright/gallery/**/*.ts\" \"tests/ct/**/*.ts\" \"tests/e2e/**/*.ts\" \"playwright-ct.config.ts\"",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.playwright.json",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,css,md}\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "api:generate": "pnpm run -w sdk:generate",
    "test-ct": "playwright test -c playwright-ct.config.ts",
    "test-e2e": "playwright test -c playwright-e2e.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.54.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.1",
    "@tanstack/vue-table": "^9.2.8",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "vue-component-type-helpers": "^3.3.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
