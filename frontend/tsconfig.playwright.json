{
  "extends": "./tsconfig.json",
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "playwright/gallery/**/*.ts",
    "tests/pages/**/*.ts",
    "tests/ct/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.playwright.tsbuildinfo"
  }
}
